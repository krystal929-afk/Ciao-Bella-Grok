{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ciao-bella-grok",
  // Homepage ranges are served by src/server.ts. Do not switch main back to
  // @tanstack/react-start/server-entry — that generic entry 404s /video/*.
  "main": "src/server.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/video/*"]
  },
  "observability": {
    "enabled": true
  }
}